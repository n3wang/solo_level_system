      "seed": 319559482,
      "version": 564,
      "versionNonce": 477736038,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783952897530,
      "link": null,
      "locked": false,
      "text": "In the title Change \"Edit Excercise\" to \"Edit\"\n\nOn the edit screen should also be in modal\nThe go back goes to the excercise modal\nWhile tapping outside dismisses both\n\nThe discard doesnt save (go back)\n\nStart with optional toggled on (showing contents)\n\n\nThere is a bug in which doesnt show the the instructions\nof an workout that has instructions whene diting\n\nAlso to the side of save have a \"duplicate\"\n\nIU give you free reign in how that should look",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the title Change \"Edit Excercise\" to \"Edit\"\n\nOn the edit screen should also be in modal\nThe go back goes to the excercise modal\nWhile tapping outside dismisses both\n\nThe discard doesnt save (go back)\n\nStart with optional toggled on (showing contents)\n\n\nThere is a bug in which doesnt show the the instructions\nof an workout that has instructions whene diting\n\nAlso to the side of save have a \"duplicate\"\n\nIU give you free reign in how that should look",
      "autoResize": true,
      "lineHeight": 1.25
    },
