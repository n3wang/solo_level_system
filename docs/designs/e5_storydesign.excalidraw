    {
      "id": "Il7QMdAmGZ_9FtRDu3qR_",
      "type": "text",
      "x": 3218.2154271817803,
      "y": 4041.266062969243,
      "width": 549.0596923828125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
