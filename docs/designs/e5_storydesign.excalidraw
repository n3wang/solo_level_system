      "versionNonce": 1324021754,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783958360992,
      "link": null,
      "locked": false,
      "text": "Lets modify workout tile component\n1. move the set and average weight to the side of the \nexcercise name\n\n2. Move th bookmark to the top right of the tile\n\n3. Move the sets show below the image, make the sets \nrectangles have the same ratio (not size, since should be \nway smaller) of the sets rectangle, to make it obvious is the same \n\n4. remove the background of the tile only have a secondary pallette color \nfor the bottom corner of the tile",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lets modify workout tile component\n1. move the set and average weight to the side of the \nexcercise name\n\n2. Move th bookmark to the top right of the tile\n\n3. Move the sets show below the image, make the sets \nrectangles have the same ratio (not size, since should be \nway smaller) of the sets rectangle, to make it obvious is the same \n\n4. remove the background of the tile only have a secondary pallette color \nfor the bottom corner of the tile",
      "autoResize": true,
      "lineHeight": 1.25
    },
